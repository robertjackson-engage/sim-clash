# dependencies
node_modules/

# electron-builder output (installer + unpacked app; regenerates via npm run dist)
dist/

# downloaded course + terrain cache (regenerates on demand from open data)
data/courses/*.json
# course aerial photos / NDVI classmaps written beside the cache by the data tools
data/courses/*.jpg
data/courses/*.png
# bounded course cache index (sizes + last played)
data/course-cache.json
# cloud course service: local directory store (when S3_BUCKET is unset)
/cloud-store/
# this computer's cloud address and build token (a secret)
data/cloud.json
# the player's shot history (bag), what waits to go to Supabase, and the Supabase
# project address + publishable key
data/bag.json*
data/bag-outbox.json*
data/supabase.json

# HD compiler build workspace + generated hole bundles
# (regenerate from open 3DEP/NAIP data; too large for normal git history)
data/hd-build-cache/
data/hd-courses/

# validated generated runtime course-art tree (regenerate from courses/curated)
/build/course-art/

# throwaway render-capture sink + screenshots (dev verification only)
.shots/
# static HUD preview harness (WebGL-free, for screenshotting the HUD)
public/_hudmock.html
public/_bg.jpg

# logs / OS cruft
npm-debug.log*
*.log
.DS_Store
Thumbs.db
.gstack/
/reference/

# ---- Sim Clash ----
# the whole local data dir: courses built by tools/arcade-holes, player profiles, coins,
# match ledger, sky cache, rendered player-name clips (everything in it regenerates or is
# personal)
/data/
# private test instances and agent / developer scratch (data dirs, screenshots, downloads)
.scratch/
.smoke-data/
# the arcade stage courses bundled into the installer (npm run prepare:arcade-data)
/build/arcade-data/
# keys: ELEVENLABS_API_KEY for player-name clips lives in the environment or here
.env
.env.*
!.env.example

# the final installer, its checksum and release notes, copied out of dist/ for the owner (never committed)
/release/

# launch drafts written for the owner to post himself (kept out of the public repository)
/docs/dev/outreach/
